{
  "name": "supremix",
  "version": "0.51.0",
  "description": "SupRemix - a modern web remake/reimagining of the 1991 puzzle classic Supaplex. Zero-dependency Node.js server + HTML5 canvas engine.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --port 3000",
    "test": "node tools/test-engine.mjs && node tools/test-client.mjs && node tools/test-server.mjs",
    "test:client": "node tools/test-client.mjs",
    "test:server": "node tools/test-server.mjs",
    "test:upgrades": "node tools/test-upgrades.mjs",
    "validate": "node tools/validate-levels.mjs",
    "check": "node tools/test-engine.mjs && node tools/test-client.mjs && node tools/test-server.mjs && node tools/validate-levels.mjs && node tools/test-upgrades.mjs && node tools/verify-solutions.mjs && node tools/design-audit.mjs",
    "solve": "node tools/verify-solutions.mjs",
    "audit": "node tools/design-audit.mjs",
    "quota": "node tools/fit-quota.mjs",
    "import": "node tools/import-original.mjs",
    "sprites": "node tools/extract-sprites.mjs",
    "sounds": "node tools/extract-sounds.mjs",
    "sounds:remaster": "node tools/remaster-sounds.mjs",
    "remaster": "node tools/remaster/render.mjs",
    "remaster:moving": "node tools/remaster/render-moving.mjs",
    "remaster:game": "node tools/remaster/game-atlas.mjs",
    "pack": "node tools/pack-assets.mjs",
    "build:demo": "node tools/build-demo.mjs",
    "levels": "sh tools/levelgen/rebuild.sh",
    "peek": "node tools/peek.mjs",
    "inspect": "node tools/dbg.mjs",
    "compare": "node tools/compare-original.mjs"
  },
  "keywords": [
    "supaplex",
    "game",
    "puzzle",
    "canvas",
    "boulder-dash",
    "remake"
  ],
  "license": "MIT",
  "private": true
}
