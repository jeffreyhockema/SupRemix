node_modules/
*.log
.DS_Store
__pycache__/
*.pyc

# A copy of the site for a webserver, made by tools/build-site.mjs.
dist/

# The optional local Node server and what goes with it. The game is a static
# site -- public/ runs on any webserver -- so none of this is part of it.
server.js
package.json
data/
tools/test-server.mjs

# The original Supaplex game's material. None of it is this project's to
# publish, so none of it is in the repository; the tools build it from your own
# copy of the game (see the README and NOTICE.md).
#   - its levels, and the pack imported from them
levels/LEVELS.DAT
levels/pack.js
#   - the remastered graphics, sounds and music, raw and packed; only
#     SupRemix's own level pack is committed
assets/
public/packs/*
!public/packs/remix.pak
